        "name": "Bannière d'état",
        "order": 1,
        "width": "6",
        "height": "2",
        "format": "<!-- Etat de la regulation, meme couleur que la bande LED ; clignote en cas d'incendie -->\n<div class=\"etat-banniere\"\n     ng-class=\"{'etat-chauffage': msg.payload.mode === 'CHAUFFAGE',\n                'etat-repos': msg.payload.mode === 'REPOS',\n                'etat-clim': msg.payload.mode === 'CLIMATISATION',\n                'etat-feu': msg.payload.fire}\">\n    <div class=\"etat-titre\">{{ msg.payload.fire ? 'INCENDIE' : msg.payload.mode }}</div>\n    <div class=\"etat-detail\">{{ msg.payload.fire ? 'Ventilateur arrêté'\n        : msg.payload.mode === 'CHAUFFAGE' ? 'Température sous le seuil bas'\n        : msg.payload.mode === 'CLIMATISATION' ? 'Température au-dessus du seuil haut'\n        : msg.payload.mode === 'REPOS' ? 'Température entre les seuils' : 'En attente de données' }}</div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": false,
