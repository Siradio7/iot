        "name": "Style du tableau de bord",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<style>\n/* Page et barre de titre */\nbody.nr-dashboard-theme md-content { background-color: #eef2f6 !important; }\nmd-toolbar { background-color: #1f3b57 !important; }\n\n/* Cadre autour de toutes les cartes : largeur exacte de 4 colonnes de 6 unites\n   (4 x 318 px + 3 espaces de 6 px + 2 marges de 6 px) pour que rien ne depasse */\n.masonry-container {\n    width: 1304px !important;\n    margin: 16px auto !important;\n    padding: 10px;\n    border: 2px solid #1f3b57;\n    border-radius: 16px;\n    background-color: #ffffff;\n}\n\n/* Cartes arrondies avec une ombre legere */\n.nr-dashboard-cardpanel {\n    border-radius: 12px !important;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12) !important;\n}\n.nr-dashboard-cardpanel > p {\n    color: #1f3b57 !important;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n}\n\n/* Banniere d'etat : couleurs de la bande LED (rouge / orange / vert) */\n.etat-banniere {\n    height: 100%;\n    border-radius: 10px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    color: #ffffff;\n    background-color: #9e9e9e;\n    transition: background-color 0.3s;\n}\n.etat-titre { font-size: 22px; font-weight: 700; letter-spacing: 0.05em; }\n.etat-detail { font-size: 13px; opacity: 0.9; }\n.etat-clim { background-color: #d93636; }\n.etat-repos { background-color: #f29f05; }\n.etat-chauffage { background-color: #2e9e4f; }\n.etat-feu { background-color: #7a0000; animation: clignote 1s infinite; }\n@keyframes clignote { 50% { opacity: 0.55; } }\n</style>",
