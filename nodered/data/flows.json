    {
        "id": "18e4be6e4ebddcc8",
        "type": "function",
        "z": "f1a0000000000001",
        "name": "Extraction statut",
        "func": "const d = msg.payload;\n\n// Ligne d'erreur du firmware (ex. capteur absent) : rien à afficher\nif (!d || !d.status) {\n    node.warn(d && d.erreur ? `ESP32 : ${d.erreur}` : \"Message sans statut ignoré\");\n    return null;\n}\n\nconst s = d.status;\n\nlet mode = \"REPOS\";\nif (s.heat === \"ON\") mode = \"CHAUFFAGE\";\nif (s.cold === \"ON\") mode = \"CLIMATISATION\";\n\nreturn [\n    { payload: s.temperature },                      // sortie 1  → jauge Température\n    { payload: s.temperature },                      // sortie 2  → courbe\n    { payload: s.light },                            // sortie 3  → jauge Luminosité\n    { payload: mode },                               // sortie 4  → texte Mode\n    { payload: s.fire },                             // sortie 5  → led Feu\n    { payload: s.cold === \"ON\" },                    // sortie 6  → led Clim\n    { payload: s.heat === \"ON\" },                    // sortie 7  → led Radiateur\n    { payload: Math.round(s.fanspeed * 100 / 255) }, // sortie 8  → jauge Ventilateur\n    { payload: `${d.regul.lt} °C` },                 // sortie 9  → Seuil bas\n    { payload: `${d.regul.ht} °C` },                 // sortie 10 → Seuil haut\n    { payload: d.location.room },                    // sortie 11 → Pièce\n    { payload: d.location.address },                 // sortie 12 → Adresse\n    { payload: `${d.info.ident} / ${d.info.user}` }  // sortie 13 → ESP / Groupe\n];\n",
        "outputs": 13,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 220,
        "wires": [
