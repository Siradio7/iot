    {
        "id": "18e4be6e4ebddcc8",
        "type": "function",
        "z": "f1a0000000000001",
        "name": "Extraction statut",
        "func": "const s = msg.payload.status;\n\nreturn [\n    { payload: s.temperature },                     // sortie 1 → jauge Temperature\n    { payload: s.temperature },                     // sortie 2 → courbe\n    { payload: s.light },                           // sortie 3 → jauge Luminosité\n    { payload: s.regul },                           // sortie 4 → texte État\n    { payload: s.fire },                            // sortie 5 → led Feu\n    { payload: s.cold === \"ON\" },                   // sortie 6 → led Clim\n    { payload: s.heat === \"ON\" },                   // sortie 7 → led Radiateur\n    { payload: Math.round(s.fanspeed * 100 / 255) } // sortie 8 → jauge Ventilateur\n];\n",
        "outputs": 8,
