{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "esp32-status",
  "title": "Statut de l'ESP32 (modèle du cours)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "location", "regul", "info", "net", "reporthost"],
  "properties": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "light", "regul", "fire", "heat", "cold", "fanspeed"],
      "properties": {
        "temperature": { "type": "number", "minimum": -55, "maximum": 125 },
        "light": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "regul": { "enum": ["RUNNING", "HALT"] },
        "fire": { "type": "boolean" },
        "heat": { "enum": ["ON", "OFF"] },
        "cold": { "enum": ["ON", "OFF"] },
        "fanspeed": { "type": "integer", "minimum": 0 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "gps", "address"],
      "properties": {
        "room": { "$ref": "#/definitions/nonEmptyString" },
        "gps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "address": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "regul": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lt", "ht"],
      "properties": {
        "lt": { "type": "number", "minimum": -55, "maximum": 125 },
        "ht": { "type": "number", "minimum": -55, "maximum": 125 }
      }
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ident", "user", "loc"],
      "properties": {
        "ident": { "$ref": "#/definitions/nonEmptyString" },
        "user": { "$ref": "#/definitions/nonEmptyString" },
        "loc": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uptime", "ssid", "mac", "ip"],
      "properties": {
        "uptime": { "type": "string", "pattern": "^(NOP|[0-9]+)$" },
        "ssid": { "$ref": "#/definitions/nonEmptyString" },
        "mac": { "type": "string", "pattern": "^(NOP|([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})$" },
        "ip": {
          "anyOf": [
            { "const": "NOP" },
            { "$ref": "#/definitions/ipv4" }
          ]
        }
      }
    },
    "reporthost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ip", "target_port", "sp"],
      "properties": {
        "target_ip": { "$ref": "#/definitions/ipv4" },
        "target_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sp": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "ipv4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    }
  }
}
